# Core
# Para public key from your Para dashboard.
NEXT_PUBLIC_PARA_API_KEY=beta_your_para_key

# PostgreSQL connection string used by API routes.
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Server-side environment for DB/runtime checks.
# Expected: production | development
BLIZ_ENV=development

# Client-visible environment. Keep this aligned with BLIZ_ENV.
# Expected: production | development
NEXT_PUBLIC_BLIZ_ENV=development

# Initial chain selected in the UI.
# Expected: celo | monad
NEXT_PUBLIC_DEFAULT_CHAIN=celo

# Monad environment
# Valid Monad IDs:
# - 143 = Monad mainnet
# - 10143 = Monad testnet
# Development values below match the current Monad testnet deployment.
NEXT_PUBLIC_MONAD_CHAIN_ID=10143

# RPC endpoint for the selected Monad environment.
# Prod: https://rpc3.monad.xyz
# Dev: https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Block explorer base URL.
# Prod: https://monadexplorer.com
# Dev: https://testnet.monadexplorer.com
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadvision.com/

# Deployed contract addresses for this Monad environment.
# Expected format: 0x + 40 hex chars
# Prod: replace with Monad mainnet deployment
# Dev: current Monad testnet deployment
NEXT_PUBLIC_MONAD_POOL_ADDRESS=0x1d42C0cD5fF14Ee71456473828996b1bC251a735
NEXT_PUBLIC_MONAD_VERIFIER_ADDRESS=0x9b5CDf523cE2C706Db157EE2135FfEEa68674772
NEXT_PUBLIC_MONAD_WITHDRAW_VERIFIER_ADDRESS=0x3c453536fA6cE97ee92f186eE954E89aB316E315

# Stablecoin used by the pool in this environment.
# Prod: replace with Monad mainnet USDC
# Dev: Monad testnet USDC
NEXT_PUBLIC_MONAD_STABLECOIN_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
NEXT_PUBLIC_MONAD_STABLECOIN_SYMBOL=USDC

# Pool token settings. Current pool design assumes 1 USDC note with 6 decimals.
NEXT_PUBLIC_MONAD_POOL_TOKEN_DECIMALS=6
NEXT_PUBLIC_MONAD_POOL_DENOMINATION=1000000

# Block where the ShieldedPool was deployed.
# Expected: integer block number, no underscores.
# Prod: replace with Monad mainnet deploy block
# Dev: current Monad testnet deploy block
NEXT_PUBLIC_MONAD_DEPLOY_BLOCK=17820960

# Set true only if the environment exists but contracts are not deployed yet.
# Expected: true | false
NEXT_PUBLIC_MONAD_PLACEHOLDER=false

# Celo environment
# Valid Celo IDs:
# - 42220 = Celo mainnet
# - 11142220 = Celo testnet
# Development values below match the current Celo testnet deployment.
NEXT_PUBLIC_CELO_CHAIN_ID=11142220

# RPC endpoint for the selected Celo environment.
# Prod: https://forno.celo.org
# Dev: https://forno.celo-sepolia.celo-testnet.org
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# Block explorer base URL.
# Prod: https://celoscan.io
# Dev: https://celo-sepolia.blockscout.com
NEXT_PUBLIC_CELO_EXPLORER_URL=https://celo-sepolia.blockscout.com

# Deployed contract addresses for this Celo environment.
# Expected format: 0x + 40 hex chars
# Prod: replace with Celo mainnet deployment
# Dev: current Celo testnet deployment
NEXT_PUBLIC_CELO_POOL_ADDRESS=0xD9AeE9351f7685b05a6B7BD8c1Ca509D24bE1e57
NEXT_PUBLIC_CELO_VERIFIER_ADDRESS=0x35C8F36a031389f469372C370dA3Cb46Dd69265a
NEXT_PUBLIC_CELO_WITHDRAW_VERIFIER_ADDRESS=0x8d10Ad45B21d4db2e7270E519a757c764c6501Ac

# Stablecoin used by the pool in this environment.
# Prod: replace with Celo mainnet USDC
# Dev: Celo testnet USDC
NEXT_PUBLIC_CELO_STABLECOIN_ADDRESS=0x01C5C0122039549AD1493B8220cABEdD739BC44E
NEXT_PUBLIC_CELO_STABLECOIN_SYMBOL=USDC

# Pool token settings. Current pool design assumes 1 USDC note with 6 decimals.
NEXT_PUBLIC_CELO_POOL_TOKEN_DECIMALS=6
NEXT_PUBLIC_CELO_POOL_DENOMINATION=1000000

# Block where the ShieldedPool was deployed.
# Expected: integer block number, no underscores.
# Prod: replace with Celo mainnet deploy block
# Dev: current Celo testnet deploy block
NEXT_PUBLIC_CELO_DEPLOY_BLOCK=19830934

# Set true only if the environment exists but contracts are not deployed yet.
# Expected: true | false
NEXT_PUBLIC_CELO_PLACEHOLDER=false
