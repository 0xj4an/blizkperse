# Core
# Para public key from your Para dashboard.
NEXT_PUBLIC_PARA_API_KEY=prod_your_para_key

# WalletConnect project ID for external wallet support.
# Get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Alchemy Account Kit / Gas Manager (client-side AA for sponsored claims).
# API key from https://dashboard.alchemy.com — required for smart-account claims.
# Prefer NEXT_PUBLIC_* so the browser can create the AA client.
# IMPORTANT (Docker/Railway): both vars MUST be declared as ARG+ENV in the root
# Dockerfile builder stage so `next build` inlines them. Runtime-only Railway
# vars are NOT enough for NEXT_PUBLIC_* — redeploy after changing them.
NEXT_PUBLIC_ALCHEMY_API_KEY=
# Optional Gas Manager policy ID from https://dashboard.alchemy.com/gas-manager
# Leave empty to still create the smart account; sponsorship applies only when set.
# Checklist (Policy ID(s) not found usually means one of these failed):
# - API key and policy ID must belong to the SAME Alchemy app
# - Policy must be Active
# - Policy networks must include the claim chain (Celo 42220, Monad 143, Robinhood 4663, …)
# - Claims use Modular Account EntryPoint v0.6 — policy must allow that entry point
# Policy should allow ShieldedPool/PoolRouter withdraw on Celo + Monad + Robinhood.
NEXT_PUBLIC_ALCHEMY_GAS_POLICY_ID=

# PostgreSQL connection string used by API routes.
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Server-side environment for DB/runtime checks.
# Expected: production | development
BLIZ_ENV=development

# Client-visible environment. Keep this aligned with BLIZ_ENV.
# Expected: production | development
NEXT_PUBLIC_BLIZ_ENV=development

# Initial chain selected in the UI.
# Expected: celo | monad | robinhood
NEXT_PUBLIC_DEFAULT_CHAIN=celo

# Protocol fee charged on top of each note deposit (basis points). 30 = 0.3%, 100 = 1%.
# Used by the create-payment UI quotes. Must match PoolRouter.feeBps after deploy.
# NOT the same as Foundry FEE_BPS (deploy/setFeeConfig only). For Docker/Railway builds,
# this var (and *_ROUTER_ADDRESS) must be available at image build time (Dockerfile ARG).
# Fee shows as 0% when PoolRouter is unset (direct pool deposits skip the protocol fee).
NEXT_PUBLIC_PROTOCOL_FEE_BPS=30
# Optional alias for the above (same meaning):
# NEXT_PUBLIC_FEE_BPS=30

# Monad environment
# Valid Monad IDs:
# - 143 = Monad mainnet
# - 10143 = Monad testnet
# Development values below match the current Monad testnet deployment.
NEXT_PUBLIC_MONAD_CHAIN_ID=10143

# RPC endpoint for the selected Monad environment.
# Prod: https://rpc3.monad.xyz
# Dev: https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Block explorer base URL.
# Prod: https://monadexplorer.com
# Dev: https://testnet.monadexplorer.com
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadvision.com/

# Deployed contract addresses for this Monad environment.
# Expected format: 0x + 40 hex chars
NEXT_PUBLIC_MONAD_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MONAD_POOL_ADDRESS=0x1d42C0cD5fF14Ee71456473828996b1bC251a735
NEXT_PUBLIC_MONAD_POOL_USDC_ADDRESS=0x1d42C0cD5fF14Ee71456473828996b1bC251a735
NEXT_PUBLIC_MONAD_VERIFIER_ADDRESS=0x9b5CDf523cE2C706Db157EE2135FfEEa68674772
NEXT_PUBLIC_MONAD_WITHDRAW_VERIFIER_ADDRESS=0x3c453536fA6cE97ee92f186eE954E89aB316E315
NEXT_PUBLIC_MONAD_DEPOSIT_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# Stablecoin used by the default USDC pool.
NEXT_PUBLIC_MONAD_STABLECOIN_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
NEXT_PUBLIC_MONAD_STABLECOIN_SYMBOL=USDC

# Pool token settings (legacy denomination kept for UI fallbacks; deposits use arbitrary raw amounts).
NEXT_PUBLIC_MONAD_POOL_TOKEN_DECIMALS=6
NEXT_PUBLIC_MONAD_POOL_DENOMINATION=1000000

# Block where the ShieldedPool was deployed.
# Expected: integer block number, no underscores.
# Prod: replace with Monad mainnet deploy block
# Dev: current Monad testnet deploy block
NEXT_PUBLIC_MONAD_DEPLOY_BLOCK=17820960

# Set true only if the environment exists but contracts are not deployed yet.
# Expected: true | false
NEXT_PUBLIC_MONAD_PLACEHOLDER=false

# Celo environment
# Valid Celo IDs:
# - 42220 = Celo mainnet
# - 11142220 = Celo testnet
# Development values below match the current Celo testnet deployment.
NEXT_PUBLIC_CELO_CHAIN_ID=11142220

# RPC endpoint for the selected Celo environment.
# Prod: https://forno.celo.org
# Dev: https://forno.celo-sepolia.celo-testnet.org
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# Block explorer base URL.
# Prod: https://celoscan.io
# Dev: https://celo-sepolia.blockscout.com
NEXT_PUBLIC_CELO_EXPLORER_URL=https://celo-sepolia.blockscout.com

# Deployed contract addresses for this Celo environment.
NEXT_PUBLIC_CELO_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CELO_POOL_ADDRESS=0xD9AeE9351f7685b05a6B7BD8c1Ca509D24bE1e57
NEXT_PUBLIC_CELO_POOL_USDC_ADDRESS=0xD9AeE9351f7685b05a6B7BD8c1Ca509D24bE1e57
# Extra mainnet pools / tokens (production). Required for multi-token selector —
# must be listed as static NEXT_PUBLIC_* keys so the client bundle can read them.
# NEXT_PUBLIC_CELO_POOL_USDT_ADDRESS=
# NEXT_PUBLIC_CELO_POOL_COPM_ADDRESS=
# COPm ERC-20 on Celo mainnet (must match the ShieldedPool token()).
# Use lowercase or valid EIP-55 checksum — a wrong mixed-case checksum makes viem reject the address.
# NEXT_PUBLIC_CELO_TOKEN_COPM_ADDRESS=0x8A567e2aE79CA692Bd748aB832081C45de4041eA
# NEXT_PUBLIC_CELO_TOKEN_USDT_ADDRESS=
# NEXT_PUBLIC_CELO_TOKEN_USDC_ADDRESS=
NEXT_PUBLIC_CELO_VERIFIER_ADDRESS=0x35C8F36a031389f469372C370dA3Cb46Dd69265a
NEXT_PUBLIC_CELO_WITHDRAW_VERIFIER_ADDRESS=0x8d10Ad45B21d4db2e7270E519a757c764c6501Ac
NEXT_PUBLIC_CELO_DEPOSIT_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# Stablecoin used by the default USDC pool.
NEXT_PUBLIC_CELO_STABLECOIN_ADDRESS=0x01C5C0122039549AD1493B8220cABEdD739BC44E
NEXT_PUBLIC_CELO_STABLECOIN_SYMBOL=USDC

# Pool token settings (legacy denomination kept for UI fallbacks; deposits use arbitrary raw amounts).
NEXT_PUBLIC_CELO_POOL_TOKEN_DECIMALS=6
NEXT_PUBLIC_CELO_POOL_DENOMINATION=1000000

# Block where the ShieldedPool was deployed.
# Expected: integer block number, no underscores.
# Prod: replace with Celo mainnet deploy block
# Dev: current Celo testnet deploy block
NEXT_PUBLIC_CELO_DEPLOY_BLOCK=19830934

# Set true only if the environment exists but contracts are not deployed yet.
# Expected: true | false
NEXT_PUBLIC_CELO_PLACEHOLDER=false

# Robinhood Chain environment (mainnet 4663 deploy).
# Valid Robinhood IDs:
# - 4663 = Robinhood Chain mainnet
# - 46630 = Robinhood Chain testnet
# Same-token claims only for now (USDG / USDe / WETH) — no stock tokens.
# AA / gasless claims: supported via defineAlchemyChain in web/lib/alchemy.ts
# when NEXT_PUBLIC_ALCHEMY_* are baked at build time and the Gas Manager policy
# includes network 4663 + EntryPoint v0.6.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663

# RPC endpoint (public). Prefer Alchemy URL in real .env — never commit API keys here.
# Public: https://rpc.mainnet.chain.robinhood.com
# Alchemy: https://robinhood-mainnet.g.alchemy.com/v2/<YOUR_KEY>
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Block explorer base URL.
# Prod: https://robinhoodchain.blockscout.com
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Deployed contract addresses (Robinhood mainnet 4663).
NEXT_PUBLIC_ROBINHOOD_ROUTER_ADDRESS=0xcDc6AdE9d348572f302690bD39BA8120F8E91db3
NEXT_PUBLIC_ROBINHOOD_POOL_ADDRESS=0xf62E5a932a832C8EA990DedD87a05162C8905224
NEXT_PUBLIC_ROBINHOOD_POOL_USDG_ADDRESS=0xf62E5a932a832C8EA990DedD87a05162C8905224
NEXT_PUBLIC_ROBINHOOD_POOL_USDE_ADDRESS=0x038803A40130734E6aB711489060Ea55F05BB475
NEXT_PUBLIC_ROBINHOOD_POOL_WETH_ADDRESS=0x27c575a0CDbBAcCFaCC6085164186B19F74b77B4
NEXT_PUBLIC_ROBINHOOD_VERIFIER_ADDRESS=0x8d10Ad45B21d4db2e7270E519a757c764c6501Ac
NEXT_PUBLIC_ROBINHOOD_WITHDRAW_VERIFIER_ADDRESS=0xD9AeE9351f7685b05a6B7BD8c1Ca509D24bE1e57
NEXT_PUBLIC_ROBINHOOD_DEPOSIT_VERIFIER_ADDRESS=0x1d42C0cD5fF14Ee71456473828996b1bC251a735

# Token addresses on Robinhood mainnet (verified on-chain).
# USDG = Global Dollar (6 decimals) — default stablecoin
NEXT_PUBLIC_ROBINHOOD_TOKEN_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
NEXT_PUBLIC_ROBINHOOD_TOKEN_USDE_ADDRESS=0x5d3a1Ff2b6BAb83b63cd9AD0787074081a52ef34
# WETH wraps native ETH (depositNative / unwrap on withdraw)
NEXT_PUBLIC_ROBINHOOD_TOKEN_WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
NEXT_PUBLIC_ROBINHOOD_WRAPPED_NATIVE_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

NEXT_PUBLIC_ROBINHOOD_STABLECOIN_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
NEXT_PUBLIC_ROBINHOOD_STABLECOIN_SYMBOL=USDG
NEXT_PUBLIC_ROBINHOOD_POOL_TOKEN_DECIMALS=6
NEXT_PUBLIC_ROBINHOOD_POOL_DENOMINATION=1000000
NEXT_PUBLIC_ROBINHOOD_DEPLOY_BLOCK=20324129

# false once ShieldedPool + verifiers are live (mainnet defaults above).
# Expected: true | false
NEXT_PUBLIC_ROBINHOOD_PLACEHOLDER=false

# Backend Merkle root registrar (must match ShieldedPool.rootRegistrar after deploy).
# Private key of the wallet that signs registerRoot txs. Keep server-only — never NEXT_PUBLIC_*.
ROOT_REGISTRAR_PRIVATE_KEY=
# Optional shared secret for cron: Authorization: Bearer <secret> on POST /api/sync-pool-root
ROOT_REGISTRAR_API_SECRET=
