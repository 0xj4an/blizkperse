# Deploy
# Deployer private key, with or without 0x prefix.
PRIVATE_KEY=

# Token used by ShieldedPool in the target network.
# Must be a 6-decimal USDC-compatible token address for the current pool design.
USDC_ADDRESS=

# RPC endpoints
# Fill only the network you are about to use.
MONAD_RPC=
CELO_RPC=
# Robinhood Chain mainnet (4663). Public RPC or Alchemy — never commit API keys.
# Public: https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC=

# Optional helper values for CLI scripts after deploy
# Set POOL_ADDRESS to the ShieldedPool address you just deployed.
POOL_ADDRESS=
B_PRIVATE_KEY=

# Private buckets (after pools include depositBatch bytecode):
# DENOM_KIND=stables6|stables18|native18|copm18
# POOL_CONFIGS=0xPoolA:stables6,0xPoolB:native18
# forge script script/SetDenominations.s.sol:SetDenominations --rpc-url "$RPC" --broadcast
# To upgrade live pools (old bytecode has no setDenominations):
# forge script script/ReplacePool.s.sol:ReplacePool --rpc-url "$RPC" --broadcast

# Local Dev
ANVIL_RPC=
LOCALHOST_PRIVATE_KEY=

# ---
# Example: Monad testnet (chain id 10143)
# PRIVATE_KEY=0xabc...
# USDC_ADDRESS=0x...
# MONAD_RPC=https://your-monad-testnet-rpc.example
#
# Example: Celo testnet (chain id 11142220)
# PRIVATE_KEY=0xabc...
# USDC_ADDRESS=0x...
# CELO_RPC=https://your-celo-testnet-rpc.example
#
# Example: Robinhood Chain mainnet (chain id 4663) — same-token pools (USDG / USDe / WETH)
# PRIVATE_KEY=0xabc...
# ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
# TOKEN_ADDRESSES=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168,0x5d3a1Ff2b6BAb83b63cd9AD0787074081a52ef34,0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# WRAPPED_NATIVE=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# (USDG 6dp, USDe 18dp, WETH 18dp wrapsNative)
