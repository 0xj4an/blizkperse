# --- Deploy (script/Deploy.s.sol) ---
PRIVATE_KEY=         # Deployer private key (with or without 0x prefix)
USDC_ADDRESS=0x754704Bc059F8C67012fEd69BC8A327a5aafb603  # Monad USDC (6 decimals)

# --- RPC ---
MONAD_RPC=https://rpc3.monad.xyz

# --- Deposit (circuits/scripts/) ---
POOL_ADDRESS=0x085BD9c0C568BE5093130E2359B00e46cb0800d1  # ShieldedPool on Monad Mainnet
# deposit_one.mjs: 1 payment per run. Requires PAYMENT_INDEX=0|1|2|3|4
# deposit_usdc.mjs: 1 deposit. COMMITMENT optional (defaults to Prover.toml)

# --- Withdraw (circuits/scripts/withdraw_one.mjs) ---
B_PRIVATE_KEY=      # Wallet B private key (the withdrawer). Falls back to PRIVATE_KEY

# --- Local Dev ---
ANVIL_RPC=
LOCALHOST_PRIVATE_KEY=
