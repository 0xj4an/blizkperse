# --- Deploy (script/Deploy.s.sol) ---
PRIVATE_KEY=         # Clave privada del deployer (sin 0x o con 0x)
USDC_ADDRESS=        # Dirección del contrato USDC en la red destino

# --- RPC (forge script --rpc-url o usar variable) ---
MONAD_RPC=           # Ej: https://rpc3.monad.xyz

# --- Deposit (circuits/scripts/) ---
POOL_ADDRESS=       # ShieldedPool desplegada (ej. 0x35C8F36a...)
# deposit_one.mjs: 1 pago por ejecución. Requiere PAYMENT_INDEX=0|1|2|3|4 (para 5 pagos demo; luego un botón puede llamar con el índice)
# deposit_usdc.mjs: 1 depósito. COMMITMENT opcional (sino usa Prover.toml)
# deposit_multi.mjs: 5 depósitos en batch (todos de una vez)

# --- Withdraw (circuits/scripts/withdraw_one.mjs) ---
B_PRIVATE_KEY=      # Clave de la wallet B (quien retira). Si no se setea, usa PRIVATE_KEY

# --- Otros ---
ANVIL_RPC=
LOCALHOST_PRIVATE_KEY=
SEPOLIA_RPC=https://rpc2.sepolia.org
